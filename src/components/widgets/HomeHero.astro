---
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
---

<section class="relative md:-mt-[76px] not-prose overflow-hidden">
  <div class="absolute inset-0 bg-hero-pattern" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-8 md:py-10 2xl:py-14">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col gap-7 md:flex-row md:items-center md:gap-8 2xl:gap-12">
          <!-- Headshot -->
          <div class="flex-shrink-0 mx-auto md:mx-0">
            <div class="relative">
              <div
                class="absolute -inset-2 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-2xl opacity-20 blur-sm"
                aria-hidden="true"
              >
              </div>
              <Image
                src="~/assets/images/IMG_0976.JPG"
                alt="Daniel J. Smith - Mathematics and Physics Tutor"
                width={240}
                height={240}
                class="relative h-48 w-48 rounded-2xl object-cover shadow-card-lg ring-4 ring-white md:h-52 md:w-52 2xl:h-60 2xl:w-60"
                loading="eager"
              />
            </div>
          </div>

          <!-- Hero text -->
          <div class="flex-1 text-center md:text-left">
            <h1
              class="mb-4 font-heading text-3xl font-bold leading-tight tracking-tight text-gray-900 md:text-4xl 2xl:text-5xl"
            >
              Expert Mathematics and Physics Tuition
            </h1>
            <p class="mb-6 text-base leading-relaxed text-muted md:text-lg 2xl:mb-8 2xl:text-xl">
              Cambridge MASt graduate with <span class="font-semibold text-emerald-700">2000+ hours'</span> experience helping
              students excel in Maths, Further Maths and Physics. Entrance exams and admissions consultation.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
              <a class="btn-primary" href="/services">
                <span>View Services</span>
                <Icon name="tabler:arrow-right" class="w-4 h-4 ml-2" />
              </a>
              <a class="btn-secondary" href="/contact">Get in Touch</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
