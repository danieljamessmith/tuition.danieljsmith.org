---
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
---

<section class="home-hero">
  <div class="home-hero-inner">
    <div class="home-introduction">
      <p class="eyebrow">Independent online tuition</p>
      <h1>Expert Mathematics<br />and Physics Tuition</h1>
      <p class="hero-lede">
        Cambridge MASt graduate with <strong>2000+ hours&rsquo;</strong> experience helping students excel in Maths, Further
        Maths and Physics. Entrance exams and admissions consultation.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/services"
          >Tuition Services <Icon name="tabler:arrow-right" class="w-4 h-4 ml-3" /></a
        >
        <a class="btn-primary" href="/contact"
          >Enquiries <Icon name="tabler:arrow-right" class="w-4 h-4 ml-3" /></a
        >
      </div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame">
        <Image
          src="~/assets/images/daniel-profile.jpg"
          alt="Daniel J. Smith - Mathematics and Physics Tutor"
          width={360}
          height={360}
          class="portrait-image"
          loading="eager"
        />
      </div>
    </figure>
  </div>
</section>
