---
import merge from 'lodash.merge';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData, MetaDataOpenGraph, MetaDataTwitter } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const metadata = merge(
  {
    title: METADATA?.title?.default || SITE?.name || '',
    titleTemplate: METADATA?.title?.template || '%s',
    canonical,
    robots: {
      index: METADATA?.robots?.index ?? false,
      follow: METADATA?.robots?.follow ?? false,
    },
    description: METADATA?.description,
    openGraph: {
      ...METADATA?.openGraph,
      url: canonical,
      siteName: METADATA?.openGraph?.siteName || SITE?.name,
      images: METADATA?.openGraph?.images || [],
      locale: I18N?.language || 'en',
      type: 'website',
    },
    twitter: METADATA?.twitter || {},
  },
  {
    title: title || undefined,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical,
    robots,
    description,
    openGraph: { url: canonical, ...openGraph },
    twitter,
  }
);

const pageTitle = title && !ignoreTitleTemplate ? metadata.titleTemplate.replace('%s', metadata.title) : metadata.title;
const pageDescription = metadata.description as string | undefined;
const pageOpenGraph = await adaptOpenGraphImages(metadata.openGraph as MetaDataOpenGraph, Astro.site);
const pageTwitter = metadata.twitter as MetaDataTwitter;
const robotsContent = `${metadata.robots.index ? 'index' : 'noindex'},${metadata.robots.follow ? 'follow' : 'nofollow'}`;
const twitterCard = pageTwitter.cardType || (pageOpenGraph.images?.length ? 'summary_large_image' : 'summary');
---

<title>{pageTitle}</title>
{pageDescription && <meta name="description" content={pageDescription} />}
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={metadata.canonical} />

<meta property="og:title" content={pageTitle} />
{pageDescription && <meta property="og:description" content={pageDescription} />}
<meta property="og:url" content={pageOpenGraph.url || metadata.canonical} />
<meta property="og:type" content={pageOpenGraph.type || 'website'} />
{pageOpenGraph.images?.map((image) => (
  <>
    <meta property="og:image" content={image.url} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
  </>
))}
{pageOpenGraph.locale && <meta property="og:locale" content={pageOpenGraph.locale} />}
{pageOpenGraph.siteName && <meta property="og:site_name" content={pageOpenGraph.siteName} />}

<meta name="twitter:card" content={twitterCard} />
{pageTwitter.handle && <meta name="twitter:creator" content={pageTwitter.handle} />}
{pageTwitter.site && <meta name="twitter:site" content={pageTwitter.site} />}
