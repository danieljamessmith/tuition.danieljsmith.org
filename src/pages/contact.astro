---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { enquiries } from '~/data/enquiries';

const metadata = {
  title: 'Contact',
  description:
    'Enquire about online maths, physics, admissions or university-level tuition, or about resources written for a student, school or organisation.',
};
---

<Layout metadata={metadata}>
  <Hero title="Enquiries" subtitle={`<span data-enquiry-subtitle>${enquiries[0].subtitle}</span>`} />

  <section class="bg-section-gradient-reverse pb-12 md:pb-16">
    <ContactUs
      id="form"
      inputs={[
        {
          type: 'text',
          name: 'name',
          label: 'Name',
        },
        {
          type: 'email',
          name: 'email',
          label: 'Email',
        },
      ]}
      enquiries={enquiries}
      textarea={{
        label: 'Message',
      }}
      disclaimer={{
        label: 'By submitting this form, you acknowledge the collection and handling of your personal information.',
        href: '/policies/#section-4',
        linkText: 'View safeguarding and data policies.',
      }}
      description="I typically reply within 24 hours."
    />
  </section>
</Layout>
